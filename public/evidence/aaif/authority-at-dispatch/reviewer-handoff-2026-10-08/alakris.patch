+    REVIEWER PATCH (2026-10-08). The pinned 2026-10-06 package exposed no envelope, so signature
+    material was ``not_emitted`` and verification ``not_measured``. The 2026-10-08 package discloses
+    them, so the check is performed: the CAIP-380 qHash is recomputed and the EIP-191 signer is
+    recovered, independently of the Proofable runtime and SDK.
+    """
+    spec = manifest.get('portable_proofs') or {}
+    path = base / str(spec.get('file') or '')
+    if not spec.get('file') or not path.is_file():
+        return None
+    import portable_envelope
+    envelopes = json.loads(path.read_bytes())
+    invalid = [{'qHash': e.get('qHash'), 'errors': verdict['errors']}
+               for e in envelopes if not (verdict := portable_envelope.verify(e))['valid']]
+    return {'count': len(envelopes),
+            'signers': sorted({str(e.get('walletAddress', '')).lower() for e in envelopes}),
+            'invalid': invalid, 'valid': not invalid and bool(envelopes)}
+
+
