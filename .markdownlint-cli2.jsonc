{
  "config": {
    "default": true,

    // Mintlify pages use YAML frontmatter at the top.
    "MD041": false,

    // We intentionally use inline HTML tables for Mintlify cards.
    "MD033": false,

    // Docs keep one paragraph per line, and details lines carry long inline tables.
    "MD013": false,

    // Allow bare URLs in custom tags/Mintlify blocks.
    "MD034": false,

    // Existing docs use compact pipe table style.
    "MD060": false,

    // The learn/compare answer pages carry a frontmatter title and a question-form h1.
    "MD025": false,

    // Bold text used as sub-labels inside examples (Mintlify convention)
    "MD036": false,

    // Fences nested in Mintlify JSX components are indented, so mixed style is expected.
    "MD046": false,

    // Sentence headings keep their period. Do not rewrite copy to satisfy this rule.
    "MD026": false
  },
  "globs": [
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "**/*.mdx"
  ]
}
