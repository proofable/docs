{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Proofable Docs",
  "theme": "mint",
  "logo": {
    "light": "/images/proofable-mark-256.png",
    "dark": "/images/proofable-mark-256.png",
    "href": "https://proofable.me"
  },
  "favicon": "/images/proofable-mark.svg",
  "colors": {
    "primary": "#2F5097",
    "light": "#98C0EF",
    "dark": "#98C0EF"
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#F5F4F1",
      "dark": "#050505"
    }
  },
  "styling": {
    "custom": "styles.css",
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "metadata": {
    "timestamp": true
  },
  "icons": {
    "library": "fontawesome"
  },
  "fonts": {
    "body": {
      "family": "Geist",
      "weight": 400
    },
    "heading": {
      "family": "Geist",
      "weight": 600
    }
  },
  "seo": {
    "metatags": {
      "theme-color": "#F5F4F1",
      "color-scheme": "light dark",
      "og:image": "https://docs.proofable.me/images/og-default.png",
      "og:image:width": "1200",
      "og:image:height": "630",
      "og:type": "website",
      "og:site_name": "Proofable Docs",
      "twitter:card": "summary_large_image",
      "twitter:image": "https://docs.proofable.me/images/og-default.png"
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Sign in",
      "href": "https://proofable.me/verify?intent=login"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "About",
        "groups": [
          {
            "group": "Overview",
            "pages": ["index", "pricing", "security", "enterprise", "migrate"]
          },
          {
            "group": "Common use cases",
