              },
              {
                "group": "Integrations",
                "pages": ["mcp/setup", "integrations/server", "widgets/overview", "widgets/verifygate"]
              },
              {
                "group": "Deployment",
                "pages": ["deployment/access-keys", "deployment/private-cloud"]
              }
            ]
          }
        ]
