            "group": "Products",
            "pages": ["agents/index", "proofs", "verification/index", "gates/index", "connections", "jobs"]
          },
          {
            "group": "Guides",
            "pages": [
              {
                "group": "Agents",
                "pages": ["mcp/guarded-action", "agents/agent-delegation", "agents/agent-identity", "agents/named-agent-card", "agents/team-agents", "agents/runtime-mount"]
              },
              {
                "group": "Proofs",
                "pages": ["verification/lifecycle", "learn/proof-links"]
              },
              {
                "group": "Verification",
                "pages": ["verification/hosted", "verification/presets", "verification/accounts", "verification/domain", "verification/layered", "verification/proof-of-human", "verification/ownership-social", "verification/ownership-org-oauth", "verification/ownership-dns-txt", "verification/ownership-pseudonym", "verification/wallet-link", "verification/wallet-risk", "verification/nft-ownership", "verification/token-holding", "verification/contract-ownership", "verification/ownership-basic", "verification/ai-content-moderation", "verification/propose-a-verifier"]
